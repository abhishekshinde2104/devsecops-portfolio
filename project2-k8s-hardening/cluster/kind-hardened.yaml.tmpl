# "After" cluster: kind with the control plane hardened against the CIS
# Kubernetes Benchmark v1.12 (see docs/hardening-report.md for the mapping
# and for the deliberate deviations).
#
# Rendered by scripts/cluster-up.sh, which substitutes the two absolute host
# paths below (kind needs absolute paths for extraMounts):
#   __HARDENING_DIR__  -> cluster/hardening   (committed: audit + admission policy)
#   __GENERATED_DIR__  -> cluster/.generated  (git-ignored: encryption key)
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: p2-hardened
nodes:
  - role: control-plane
    image: kindest/node:v1.34.11@sha256:44e222ee2132dab25ff87301682f89eb82c7880ea3a1bf543bfe9708fd08d67d
    extraMounts:
      - hostPath: __HARDENING_DIR__
        containerPath: /etc/kubernetes/hardening
        readOnly: true
      - hostPath: __GENERATED_DIR__
        containerPath: /etc/kubernetes/encryption
        readOnly: true
    kubeadmConfigPatches:
      - |
        # kind renders kubeadm v1beta3 for this Kubernetes version: extraArgs is a map.
        kind: ClusterConfiguration
        apiServer:
          extraArgs:
            # CIS 1.2.15: no profiling endpoint
            profiling: "false"
            # CIS 1.2.9 / 1.2.14: admission plugins (NodeRestriction is already on)
            enable-admission-plugins: NodeRestriction,EventRateLimit
            admission-control-config-file: /etc/kubernetes/hardening/admission-config.yaml
            # CIS 1.2.16-1.2.19: audit logging with rotation
            audit-policy-file: /etc/kubernetes/hardening/audit-policy.yaml
            audit-log-path: /var/log/kubernetes/audit/audit.log
            audit-log-maxage: "30"
            audit-log-maxbackup: "10"
            audit-log-maxsize: "100"
            # CIS 1.2.27 / 1.2.28: encrypt Secrets at rest in etcd
            encryption-provider-config: /etc/kubernetes/encryption/encryption-config.yaml
            # CIS 1.2.29: strong TLS cipher suites only
            tls-cipher-suites: TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256,TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
            service-account-lookup: "true"
            # CIS 1.2.30: service-account tokens keep their requested lifetime
            service-account-extend-token-expiration: "false"
            # CIS 1.2.5: verify kubelet serving certificates against the cluster
            # CA. Kubelets request CA-signed serving certs (serverTLSBootstrap
            # below) and scripts/cluster-up.sh approves those CSRs.
            kubelet-certificate-authority: /etc/kubernetes/pki/ca.crt
          extraVolumes:
            - name: hardening
              hostPath: /etc/kubernetes/hardening
              mountPath: /etc/kubernetes/hardening
              readOnly: true
              pathType: Directory
            - name: encryption
              hostPath: /etc/kubernetes/encryption
              mountPath: /etc/kubernetes/encryption
              readOnly: true
              pathType: Directory
            - name: audit-log
              hostPath: /var/log/kubernetes/audit
              mountPath: /var/log/kubernetes/audit
              readOnly: false
              pathType: DirectoryOrCreate
        controllerManager:
          extraArgs:
            # CIS 1.3.2 / 1.3.1
            profiling: "false"
            terminated-pod-gc-threshold: "100"
        scheduler:
          extraArgs:
            # CIS 1.4.1
            profiling: "false"
      - |
        kind: KubeletConfiguration
        # CIS 4.2.x (anonymous auth off, webhook authz and readOnlyPort 0
        # are already kind/kubeadm defaults and verified by kube-bench)
        tlsCipherSuites:
          - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
          - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
          - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
          - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
          - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256
          - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
        serverTLSBootstrap: true      # CIS 1.2.5 / 4.2.x: CA-signed kubelet serving cert
        podPidsLimit: 4096
        eventRecordQPS: 5
        makeIPTablesUtilChains: true
